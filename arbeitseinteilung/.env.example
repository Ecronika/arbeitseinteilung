# ─── Pflichtfelder ────────────────────────────────────────────────────────────

# Geheimschlüssel für Flask-Sessions. Generieren mit:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
# NIEMALS diesen Platzhalter im Produktivbetrieb verwenden!
SECRET_KEY=

# ─── Optionale Felder ─────────────────────────────────────────────────────────

# Pfad zur SQLite-Datenbank im Container (Standard passt zu docker-compose.yml)
DATABASE_PATH=/app/data/arbeitseinteilung.db

# Erlaubte CORS-Ursprünge (Browser-URL, unter der die App erreichbar ist).
# Im Intranet typisch: http://192.168.x.x:8090
# Mehrere Ursprünge als kommagetrennte Liste: http://host1:8090,http://host2:8090
CORS_ORIGINS=http://localhost:8090

# Auf 'true' setzen, wenn die App hinter einem Reverse-Proxy (nginx, traefik) läuft.
# Aktiviert den Werkzeug ProxyFix für korrekte IP-Erkennung.
USE_REVERSE_PROXY=false

# Anzahl Gunicorn-Worker. MUSS 1 bleiben wegen In-Memory WebSocket-Locks!
GUNICORN_WORKERS=1
